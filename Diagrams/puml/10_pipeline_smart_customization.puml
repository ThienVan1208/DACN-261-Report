@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155

top to bottom direction

actor "Người chơi" as User

package "Ứng dụng Unity 6 (Giao diện & Hiển thị 3D)" #EFF6FF {
  [Giao diện tùy biến nhân vật\n(Chọn ảnh 2D, Nam/Nữ, 6 kiểu tóc 3D, thanh trượt chỉnh tay)] as SCUI
  [Bộ điều phối tùy biến nhân vật\n(Gọi xử lý cục bộ & nạp kết quả tự động)] as SCCreator
  [Nhân vật 3D chuẩn MPFB v2\n(Vật liệu mắt phản sáng + 6 kiểu tóc 3D khớp da đầu)] as Mesh3D
}

package "Bộ xử lý cục bộ tự xây dựng (Python, RTX 4050 6 GB — Tắt HRN & IC-Light)" #ECFDF5 {
  package "Nhánh 1: Tái tạo hình học khuôn mặt 3D" #F8FAFC {
    [MediaPipe Face Mesh\n(478 điểm mốc 2D)] as MP
    [Mô hình hồi quy ONNX\n(25 thông số độc lập, 24.000 mẫu PyTorch3D)] as ONNX
    [Tinh chỉnh giới hạn biên độ (±0.08)\n& khóa an toàn vùng môi] as BVLS
    MP --> ONNX
    ONNX --> BVLS
  }
  package "Nhánh 2: Kết cấu da & khử bóng đối xứng" #F8FAFC {
    [Chiếu ngược tam giác PyTorch3D\n(Tham khảo ý tưởng MeInGame)] as Py3D
    [Khử bóng đối xứng hai bên (Lab)\n(Không dùng IC-Light)] as Delight
    [Tách hốc mắt & lọc vệt men răng] as Mask
    [Hòa trộn biên cổ đa tầng (64 px)\n(Không dùng HRN)] as Blend
    Py3D --> Delight
    Delight --> Mask
    Mask --> Blend
  }
  [Trích màu mống mắt (sáng tối thiểu 0.38)\nvà màu tóc vùng viền trán] as ColorExt
}

User --> SCUI : Tải ảnh chân dung 2D
SCUI --> SCCreator
SCCreator --> MP : ảnh chân dung + giới tính
SCCreator --> Py3D
SCCreator --> ColorExt
BVLS --> SCCreator : 25 thông số hình thái
Blend --> SCCreator : bản đồ da đã khử bóng (~5.9 giây)
ColorExt --> SCCreator : màu mắt & màu tóc
SCCreator --> Mesh3D : cập nhật nhân vật 3D thời gian thực
@enduml
