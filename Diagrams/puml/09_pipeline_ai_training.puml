@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam BorderColor #475569
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155
skinparam UsecaseBackgroundColor #F1F5F9
skinparam UsecaseBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorBorderColor #334155
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155
skinparam SequenceParticipantBackgroundColor #F1F5F9
skinparam SequenceParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706

top to bottom direction

package "Tầng 1: Nền tảng mô phỏng & Thầy dạy cổ điển" #F1F5F9 {
  [Pure C# Core Engine\n(Headless NullGameEventListener)] as Core
  [MinimaxSearch + Alpha-Beta + PVS\n(MinimaxEvaluator, Depth 1..6)] as Minimax
  Core --> Minimax
}

package "Tầng 2: Học bắt chước và Học tăng cường (Unity ML-Agents)" #EFF6FF {
  [BehaviourCloneBootstrapper\n& DaggerBootstrapper\n(Thu thập tập mẫu Teacher Depth 4)] as BC
  [PPO Self-Play Training\n(Multi-Arena Parallel, ObservationEncoderV2 654f)] as PPO
  [AgentRewardHandler\n(Potential-Based Shaping Delta V_NNUE)] as Reward
  Minimax --> BC : sinh nhãn nước đi (T=0.8 / T=0)
  BC --> PPO : khởi tạo trọng số (BC -> RL)
  Reward --> PPO : định hình phần thưởng mật độ cao
}

package "Tầng 3: Mạng đánh giá nhẹ & Đồng huấn luyện (NNUE + Hybrid)" #ECFDF5 {
  [NNUEBootstrapper\n(Sinh Multi-Generation Replay Buffer .jsonl)] as NNUEData
  [PyTorch NNUE / Residual NNUE Trainer\n(Input 654f -> Export .bytes)] as NNUETrain
  [NNUEFastEvaluator (SIMD Sparse Columns)\n+ ZobristHash Transposition Table] as NNUEEval
  [HybridAgentBotController\n(PVS + Soft Policy LMR + NNUE Leaf)] as Hybrid
  PPO --> NNUEData : sinh ván đấu sát thực chiến
  NNUEData --> NNUETrain
  NNUETrain --> NNUEEval
  PPO --> Hybrid : Policy Priors (.onnx)
  NNUEEval --> Hybrid : Value Evaluation (.bytes)
  NNUEEval ..> Reward : đồng huấn luyện vòng lặp (Gen N -> Gen N+1)
}

package "Tầng 4: Tiến hóa luật biểu tượng bằng LLM (FunSearch B1 V2)" #F5F3FF {
  [Gemini API Synthesizer\n(Sinh module C# 15-35 dòng trên 36-bit ulong)] as Gemini
  [4-Gate Verification Harness\n(Static Guard -> dotnet build -> Latency/Symmetry -> Paired Arena)] as Gate
  [LLMEvolvedModuleBank\n(8 Context Gates + LOO Ablation Pruning)] as Bank
  [LLMBotController\n(LLMSymbolicEvaluator + MinimaxSearch)] as LLMBot
  Gemini --> Gate
  Gate --> Bank : chỉ giữ module thắng A/B test
  Bank --> LLMBot
}

package "Tầng 5: Kiểm chuẩn tự động (BenchmarkRunner)" #FFFBEB {
  [BenchmarkBootstrapper & FileBenchmarkRecorder\n(100 - 1000 ván đối kháng tự động)] as Bench
}

Minimax --> Bench
PPO --> Bench
Hybrid --> Bench
LLMBot --> Bench
@enduml
