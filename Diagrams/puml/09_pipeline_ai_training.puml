@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155

top to bottom direction

package "Tầng 1: Nền tảng mô phỏng tốc độ cao và thầy dạy tìm kiếm" #F1F5F9 {
  [Lõi luật chơi tách đồ họa\n(Chế độ mô phỏng không hiển thị)] as Core
  [Khung tìm kiếm Minimax Alpha-Beta\n(Bảng Zobrist 64-bit, gia hạn Surge, độ sâu 1..6)] as Minimax
  Core --> Minimax
}

package "Tầng 2: Học bắt chước và Học tăng cường PPO (Unity ML-Agents)" #EFF6FF {
  [Thu thập dữ liệu mẫu\n(Behavioral Cloning & DAgger từ độ sâu 4)] as BC
  [Huấn luyện PPO tự đấu song song\n(Bộ mã hóa 654 đặc trưng, lọc nước sai luật)] as PPO
  [Định hình phần thưởng theo hàm thế năng NNUE] as Reward
  Minimax --> BC : sinh tập thế cờ đa dạng
  BC --> PPO : khởi tạo trọng số ban đầu
  Reward --> PPO : tín hiệu dẫn hướng dày đặc
}

package "Tầng 3: Hybrid Bot (Mạng NNUE / Residual NNUE & đồng huấn luyện)" #ECFDF5 {
  [Sinh tập thế cờ thực chiến đa thế hệ] as NNUEData
  [Huấn luyện NNUE / Residual NNUE\n(Mạng thưa 654 -> 128 -> 64 -> 1)] as NNUETrain
  [Hybrid Bot\n(Tìm kiếm Minimax + Chính sách PPO + Residual NNUE)] as Hybrid
  PPO --> NNUEData : tự đấu sinh dữ liệu
  NNUEData --> NNUETrain
  PPO --> Hybrid : ưu tiên nhánh tìm kiếm
  NNUETrain --> Hybrid : chấm điểm nút lá nhanh (~66 ms)
  NNUETrain ..> Reward : vòng lặp đồng huấn luyện thế hệ mới
}

package "Tầng 4: LLM Bot (Tiến hóa tập luật biểu tượng theo FunSearch)" #F5F3FF {
  [Gemini API sinh mô-đun quy tắc\n(15-35 dòng theo 8 ngữ cảnh chiến thuật)] as Gemini
  [4 cổng kiểm định tự động\n(Cú pháp -> Biên dịch -> Tốc độ/Đối xứng -> Đấu cặp)] as Gate
  [LLM Bot\n(Minimax + Ngân hàng 5 mô-đun biểu tượng)] as LLMBot
  Gemini --> Gate
  Gate --> LLMBot : giữ lại mô-đun cải thiện tỷ lệ thắng
}

package "Tầng 5: Kiểm chuẩn đối kháng tự động" #FFFBEB {
  [Hệ thống đấu tự động 100 - 1.000 ván\n(Ghi nhận tỷ lệ thắng, hòa, thua & thời gian/nước)] as Bench
}

Minimax --> Bench
PPO --> Bench
Hybrid --> Bench
LLMBot --> Bench
@enduml
