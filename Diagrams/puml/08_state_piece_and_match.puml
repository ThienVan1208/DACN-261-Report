@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155

state "Vòng đời trận đấu (Lõi luật chơi)" as MatchLife {
  [*] --> KhởiTạo : Nạp đội hình 12 điểm + Sinh 1-2 vật cản trung tuyến
  KhởiTạo --> LượtChơi : Khởi tạo 3 AP mỗi bên (tối đa 5 AP)
  state "Lượt chơi của một phe" as LượtChơi {
    [*] --> ChờNướcĐi : Hồi +2 AP (+1 nếu có kỹ năng cộng AP)
    ChờNướcĐi --> ThẩmĐịnh : Nhận lệnh từ người chơi / mạng / AI
    ThẩmĐịnh --> ThựcThi : Hợp lệ (đủ AP, đúng luật hợp thể)
    ThẩmĐịnh --> ChờNướcĐi : Không hợp lệ
    ThựcThi --> ĐònBồiSurge : Vừa hợp thể & còn đủ AP
    ThựcThi --> KếtThúcLượt : Di chuyển / Tấn công / Bỏ lượt
    ĐònBồiSurge --> KếtThúcLượt : Tung đòn bồi hoặc chọn giữ AP
  }
  LượtChơi --> KếtThúcTrận : Mất Vua / Hết nước hợp lệ / Đạt 60 lượt
  LượtChơi --> LượtChơi : Đổi lượt phe đối phương
  KếtThúcTrận --> [*] : Phát sự kiện kết thúc trận
}

state "Máy trạng thái 5 pha của quân cờ 3D" as PieceFSM {
  [*] --> ĐứngChờ
  ĐứngChờ --> DiChuyển : Sự kiện di chuyển
  DiChuyển --> ĐứngChờ : Đến ô đích
  ĐứngChờ --> TấnCông : Sự kiện tấn công / ăn quân
  TấnCông --> ĐứngChờ : Hoàn tất chuỗi hoạt họa
  ĐứngChờ --> BịĐánhTrúng : Bị tấn công / vỡ khiên
  BịĐánhTrúng --> ĐứngChờ : Hồi tư thế
  ĐứngChờ --> BịTiêuDiệt : Sự kiện tiêu diệt quân
  BịĐánhTrúng --> BịTiêuDiệt : Bị hạ gục sau đòn đánh
  BịTiêuDiệt --> [*] : Ẩn quân 3D / đưa vào danh sách bị diệt
}
@enduml
