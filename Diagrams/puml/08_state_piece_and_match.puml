@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam BorderColor #475569
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155
skinparam UsecaseBackgroundColor #F1F5F9
skinparam UsecaseBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorBorderColor #334155
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155
skinparam SequenceParticipantBackgroundColor #F1F5F9
skinparam SequenceParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706


state "Vòng đời trận đấu (MatchManager & GameEventHandler)" as MatchLife {
  [*] --> MatchInit : Nạp Squad + Sinh Obstacles
  MatchInit --> PlayerTurn : Khởi tạo StartAP=3 (MaxAP=5) & TurnCount = 1
  state PlayerTurn {
    [*] --> WaitingInput : Hồi +2 AP (+1 nếu có BonusAP)
    WaitingInput --> ValidatingMove : Nhận MoveCommand từ IMoveInputProvider
    ValidatingMove --> ExecutingMove : ValidateAction hợp lệ
    ValidatingMove --> WaitingInput : Không hợp lệ
    ExecutingMove --> SurgeSubPhase : Hành động là Merge & còn đủ AP
    ExecutingMove --> TurnEnd : Di chuyển / Tấn công / Pass
    SurgeSubPhase --> TurnEnd : Đòn bồi hoàn tất hoặc chọn Bank AP
  }
  PlayerTurn --> GameOver : Vua bị tiêu diệt / Không còn nước hợp lệ / TurnCount >= MaxTurns
  PlayerTurn --> PlayerTurn : Đổi ActivePlayer
  GameOver --> [*] : Phát GameOverEvent
}

state "Máy trạng thái diễn hoạt quân cờ (PieceView FSM)" as PieceFSM {
  [*] --> IdleStateBase
  IdleStateBase --> MoveStateBase : PieceMovedEvent
  MoveStateBase --> IdleStateBase : Đến ô đích
  IdleStateBase --> AttackStateBase : PieceKilledEvent / Attack
  AttackStateBase --> IdleStateBase : Animation Relay hoàn tất
  IdleStateBase --> GetHitStateBase : Bị tấn công (GetHit)
  GetHitStateBase --> IdleStateBase : Kết thúc hit-stun
  IdleStateBase --> DeathStateBase : PieceKilledEvent
  GetHitStateBase --> DeathStateBase : Chết sau đòn đánh
  DeathStateBase --> [*] : Hủy PieceView / Chuyển vào Graveyard HUD
}
@enduml
