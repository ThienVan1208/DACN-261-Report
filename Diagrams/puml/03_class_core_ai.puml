@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0

interface "Cổng nhận nước đi" as InPort {
  +Yêu cầu nước đi bất đồng bộ()
}

interface "Cổng lắng nghe sự kiện" as OutPort {
  +Tiếp nhận đợt sự kiện()
}

class "Bộ điều phối trận đấu" as MatchMgr {
  -Trạng thái bàn cờ hiện tại
  -Nguồn nước đi 2 phe
  -Danh sách thành phần lắng nghe
  +Khởi tạo và vận hành vòng lặp lượt()
}

class "Bộ xử lý sự kiện luật" as EvtHandler {
  +Thực thi lệnh và gom đợt sự kiện()
}

class "Trạng thái bàn cờ 6x6" as State {
  +Lưới 36 ô quân cờ và vật cản
  +Điểm AP hai bên (tối đa 5)
  +Trạng thái đòn bồi Surge & lượt bỏ
  +Đi thử và hoàn tác cho tìm kiếm AI()
}

class "Quân cờ & 9 kỹ năng" as Piece {
  +Phe sở hữu & loại quân gốc
  +Tập cờ 9 kỹ năng nội tại
  +Trạng thái đã hợp thể
  +Kiểm tra và thực hiện hợp thể()
}

class "Bộ thẩm định luật chơi" as Validator {
  +Kiểm tra nước đi hợp lệ & chi phí AP()
  +Sinh danh sách nước đi hợp lệ()
  +Kiểm tra chiếu Vua & hết nước đi()
}

class "Bộ mã hóa 654 đặc trưng" as Encoder {
  +Mã hóa 36 ô x 18 kênh + 6 biến toàn cục()
}

class "Khung tìm kiếm Minimax Alpha-Beta" as Minimax {
  +Cắt tỉa Alpha-Beta & bảng Zobrist 64-bit
  +Gia hạn độ sâu khi có Surge (tối đa 2)
  +Giảm độ sâu thăm dò theo mạng chính sách()
}

class "Mạng chính sách (BC / PPO)" as PolicyNet {
  +Gợi ý phân phối xác suất nước đi()
}

class "Mạng đánh giá nhanh NNUE" as NNUE {
  +Kiến trúc thưa 654 -> 128 -> 64 -> 1
  +Biến thể Residual NNUE (hiệu chỉnh dư)()
}

class "Hybrid Bot" as HybridBot {
  +Kết hợp Minimax + Chính sách PPO + NNUE()
}

class "LLM Bot" as LLMBot {
  +Tìm kiếm Minimax kết hợp luật biểu tượng()
}

class "Ngân hàng luật biểu tượng" as LLMBank {
  +5 mô-đun kiểm định theo 8 ngữ cảnh
  +Đánh giá đối xứng hai phe()
}

MatchMgr --> State
MatchMgr --> EvtHandler
EvtHandler --> Validator
EvtHandler --> State
MatchMgr --> InPort
MatchMgr --> OutPort
State "1" *-- "0..36" Piece

HybridBot ..|> InPort
LLMBot ..|> InPort

HybridBot --> Encoder
HybridBot --> Minimax
HybridBot --> PolicyNet
HybridBot --> NNUE
LLMBot --> Minimax
LLMBot --> LLMBank
@enduml
