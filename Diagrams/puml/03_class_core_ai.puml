@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam BorderColor #475569
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155
skinparam UsecaseBackgroundColor #F1F5F9
skinparam UsecaseBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorBorderColor #334155
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155
skinparam SequenceParticipantBackgroundColor #F1F5F9
skinparam SequenceParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706

skinparam classAttributeIconSize 0

interface IMoveInputProvider {
  +IsBot : bool
  +RequestActionAsync(state: GameState, ct: CancellationToken) : UniTask<MoveCommand>
}

interface IGameEventListener {
  +OnEventsDispatchedAsync(batch: GameEventBatch) : UniTask
}

class MatchManager <<MonoBehaviour>> {
  -_gameState : GameState
  +GameState : GameState
  -_player1Input : IMoveInputProvider
  -_player2Input : IMoveInputProvider
  -_eventListeners : List<IGameEventListener>
  +Initialize(...)
  +StartMatchAsync() : UniTask
}

class GameEventHandler <<static>> {
  +ExecuteCommand(state, cmd) : GameEventBatch
}

class GameState {
  +Tiles : Piece[36]
  +Obstacles : bool[36]
  +ActivePlayer : PlayerId
  +TurnCount : int
  +P1_AP : int
  +P2_AP : int
  +MaxAP : int
  +ApMergeCost : int
  +SurgeTile : int
  +P1_PassChargesLeft : int
  +P2_PassChargesLeft : int
  +GenerateProceduralObstacles(rng: Random)
  +ApplyMove(cmd: MoveCommand)
  +ApplyMoveWithUndo(cmd: MoveCommand) : UndoToken
  +Clone() : GameState
}

class Piece {
  +Owner : PlayerId
  +PieceType : PieceType
  +Passives : PassiveFlags
  +HasMerged : bool
  +CanMergeWith(target: Piece) : bool
  +Absorb(source: Piece) : void
}

class MoveValidator <<static>> {
  +ValidateAction(state, from, to, out ap, out type) : bool
  +GenerateLegalMovesFast(state, list) : void
  +HasAnyLegalAction(state, tile) : bool
  +HasAnyLegalActionForPlayer(state, player) : bool
  +IsKingInCheck(state, player) : bool
}

class MinimaxSearch <<static>> {
  +BestAction(root, maximizer, depth, temp) : int
  +Search(root, maximizer, options) : SearchResult
  -AlphaBeta(...) : float
}

class ObservationEncoderV2 <<static>> {
  +ObservationSize = 654
  +Encode(state, buffer, activePlayer) : void
}

class NNUEModelWeights {
  +InputSize : int
  +W1Transposed : float[]
}

class NNUEFastEvaluator <<static>> {
  +LoadWeights(...) : NNUEModelWeights
  +EvaluateState(st, p, w) : float
  +EvaluateTacticalLeaf(st, p, w) : float
  +EvaluateResidualLeaf(st, p, d, w) : float
}

class LLMSymbolicEvaluator <<static>> {
  +Evaluate(state, perspective) : float
}

class LLMEvolvedModuleBank <<static>> {
  +ModuleCount = 5
  +EvaluateSymmetric(selfView, oppView) : float
}

class AgentBotController {
  -_minimaxDepth : int
  +CollectObservations(sensor)
  +OnActionReceived(actions)
  +WriteDiscreteActionMask(mask)
  +RequestActionAsync(state, ct) : UniTask<MoveCommand>
}

class NeuralMinimaxBotController {
  -_minimaxDepth : int
  -_topKCandidates : int
  +RequestActionAsync(state, ct) : UniTask<MoveCommand>
}

class HybridAgentBotController {
  -_nnueWeights : NNUEModelWeights
  -_minimaxDepth : int
  -_useResidualMode : bool
  +RequestActionAsync(state, ct) : UniTask<MoveCommand>
}

class NNUEBotController {
  -_nnueWeights : NNUEModelWeights
  -_useResidualMode : bool
  +RequestActionAsync(state, ct) : UniTask<MoveCommand>
}

class LLMBotController {
  -_minimaxDepth : int
  +RequestActionAsync(state, ct) : UniTask<MoveCommand>
}

MatchManager --> GameState
MatchManager --> GameEventHandler
GameEventHandler --> MoveValidator
GameEventHandler --> GameState
MatchManager --> IMoveInputProvider
MatchManager --> IGameEventListener
GameState "1" *-- "0..36" Piece

AgentBotController ..|> IMoveInputProvider
NeuralMinimaxBotController ..|> IMoveInputProvider
HybridAgentBotController ..|> IMoveInputProvider
NNUEBotController ..|> IMoveInputProvider
LLMBotController ..|> IMoveInputProvider

AgentBotController --> ObservationEncoderV2
AgentBotController --> MinimaxSearch
NeuralMinimaxBotController --> MinimaxSearch
HybridAgentBotController --> MinimaxSearch
HybridAgentBotController --> NNUEFastEvaluator
HybridAgentBotController o-- NNUEModelWeights
NNUEBotController --> MinimaxSearch
NNUEBotController --> NNUEFastEvaluator
NNUEBotController o-- NNUEModelWeights
NNUEFastEvaluator ..> NNUEModelWeights
LLMBotController --> MinimaxSearch
LLMBotController --> LLMSymbolicEvaluator
LLMSymbolicEvaluator --> LLMEvolvedModuleBank
@enduml
