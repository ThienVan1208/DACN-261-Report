@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam BorderColor #475569
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155
skinparam UsecaseBackgroundColor #F1F5F9
skinparam UsecaseBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorBorderColor #334155
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155
skinparam SequenceParticipantBackgroundColor #F1F5F9
skinparam SequenceParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706

autonumber

actor "Host (Player 1)" as Host
participant "UIPopupLobby" as UI
participant "OnlineSessionManager\n(Host)" as SessH
participant "Photon Fusion Cloud\n(ReliableData Stream)" as Photon
participant "OnlineSessionManager\n(Client)" as SessC
actor "Client (Player 2)" as Client

Host -> UI : Chọn Region + Bấm Create Room
UI -> SessH : CreateRoomAsync(RoomID) -> GameMode.Shared
SessH -> Photon : Khởi tạo NetworkRunner & mở phòng
Photon --> SessH : OnConnectedToServer (Assign White Slot)
SessH --> UI : Cập nhật danh sách Slot (Host = White)

Client -> SessC : Nhập RoomID + JoinRoomAsync(RoomID)
SessC -> Photon : Kết nối phiên phòng (GameMode.Shared)
Photon --> SessH : OnPlayerJoined(Client)
SessC -> Photon : SendReliableData(MSG_MAP_PLAYER_NAME)
SessC -> Photon : SendReliableData(MSG_REQUEST_SLOT_SYNC)
Photon --> SessH : OnReliableDataReceived
SessH -> Photon : Broadcast(MSG_SLOTS_UPDATE + PlayerNames)
Photon --> SessC : Cập nhật Slot hiện tại (Client vào Black/Spectator)

Client -> SessC : Chỉnh Squad (12 Slots) & bấm Ready
SessC -> Photon : SendReliableData(MSG_READY_UPDATE + SquadData)
Photon --> SessH : OnlineDataBroadcastNetwork.DispatchReadyUpdate()
SessH -> SessH : Lưu _blackSquad & _isBlackReady = true

Host -> UI : Bấm Ready & StartOnlineMatch() (khi cả 2 Ready)
SessH -> SessH : Sinh _matchSeed & Obstacles (Row 2-3)
SessH -> Photon : Broadcast(MSG_MATCH_INIT: Seed, WhiteSquad, BlackSquad, Obstacles)
Photon --> SessC : Nhận MatchInitData đồng bộ 100%
SessH -> SessH : Load Scene PvPOnlScene (TriggerMatchStart)
SessC -> SessC : Load Scene PvPOnlScene (TriggerMatchStart)
@enduml
