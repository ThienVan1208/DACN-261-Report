@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam BorderColor #475569
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155
skinparam UsecaseBackgroundColor #F1F5F9
skinparam UsecaseBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorBorderColor #334155
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155
skinparam SequenceParticipantBackgroundColor #F1F5F9
skinparam SequenceParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706

skinparam classAttributeIconSize 0

interface IGameEventListener {
  +OnEventsDispatchedAsync(batch: GameEventBatch) : UniTask
}

interface IVisualNode {
  +ExecuteAsync(ct: CancellationToken) : UniTask
}

class VisualQueueManager {
  +OnMatchInitialized : static event
  +OnApUpdated : static event
  +OnTurnChanged : static event
  +OnPieceEliminated : static event
  +OnGameOver : static event
  -_boardView : BoardView
  +PlayBatchAsync(batch: GameEventBatch) : UniTask
}

class VisualSequenceBuilder {
  +BuildNodes(batch, boardView) : List<IVisualNode>
}

class PieceMoveVisualNode
class PieceAttackVisualNode
class CamShakedVisualNode
class ZoomCamVisualNode
class BoardRotatedVisualNode

class BoardView {
  -_tiles : TileView[36]
  -_pieceViews : Dictionary<int, PieceView>
  +SpawnBoard(state: GameState)
  +HighlightValidTiles(indices)
  +MovePieceView(from, to)
}

class TileView {
  +TileIndex : int
  +SetHighlightState(state)
  +OnPointerHover()
}

abstract class PieceView {
  -_stateMachine : StateMachine
  -_animationRelay : PieceAnimationRelay
  +PlayMove(targetPos) : UniTask
  +PlayAttack(targetPos) : UniTask
  +PlayTargetHitVFX(pos) : virtual void
  +TriggerVFX(vfxName)
}

class PieceAnimationRelay {
  -_pieceView : PieceView
  +PlayVFX(vfxName: string)
  +StopVFX(vfxName: string)
  +OnAttackSwing()
  +OnHit()
}

class ConcreteMedievalPieceViews <<6 Piece Classes>> {
  KingPieceView / DarkMagePieceView
  GreatSwordKnightPieceView / VampirePieceView
  SwordShieldKnightPieceView / TraineeMagePieceView
}

class UIManager {
  -_mapper : UIMapper
  -_activeViews : Stack<UIViewBase>
  +ShowView<T>()
  +ShowPopup<T>()
  +HideCurrentPopup()
}

class UIMapper <<ScriptableObject>> {
  +uiMappings : UIElementMapping[]
  +GetUIView(uiName) : UIViewBase
  +GetUIView<T>() : T
}

abstract class UIViewBase
abstract class UIPopupBase
class UIInGameHUD
class UIPopupLobby
class UIPopupSquadBuilder
class UIPopupSettings

VisualQueueManager ..|> IGameEventListener
VisualQueueManager --> VisualSequenceBuilder
VisualQueueManager --> BoardView
VisualSequenceBuilder ..> IVisualNode

PieceMoveVisualNode ..|> IVisualNode
PieceAttackVisualNode ..|> IVisualNode
CamShakedVisualNode ..|> IVisualNode
ZoomCamVisualNode ..|> IVisualNode
BoardRotatedVisualNode ..|> IVisualNode

BoardView "1" *-- "36" TileView
BoardView "1" *-- "0..36" PieceView
PieceView *-- PieceAnimationRelay
ConcreteMedievalPieceViews --|> PieceView

UIManager --> UIMapper
UIManager --> UIViewBase
UIPopupBase --|> UIViewBase
UIInGameHUD --|> UIViewBase
UIPopupLobby --|> UIPopupBase
UIPopupSquadBuilder --|> UIPopupBase
UIPopupSettings --|> UIPopupBase
UIInGameHUD ..> VisualQueueManager : listens static events
@enduml
