@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0

interface "Cổng lắng nghe sự kiện" as OutPort {
  +Tiếp nhận đợt sự kiện tuần tự()
}

class "Hàng đợi diễn hoạt bất đồng bộ" as VisualQ {
  +Phát lần lượt 8 nhóm sự kiện trọng tâm
  +Phát tín hiệu cập nhật bảng thông số
  +Tự hủy an toàn khi chuyển màn chơi()
}

class "Trình ghép chuỗi diễn hoạt" as SeqBuilder {
  +Ghép nối tuần tự hoặc song song các bước()
}

class "Các bước diễn hoạt 3D" as Nodes {
  +Di chuyển kèm vệt bóng mờ
  +Tấn công, rung & phóng cận cảnh góc quay
  +Xoay bàn cờ 180 độ (PvP Offline)
}

class "Bàn cờ 3D" as BoardView {
  +Dựng lưới 36 ô và vật cản trung tuyến
  +Tô sáng 3 loại nước đi hợp lệ()
}

class "Ô cờ 3D (36 ô)" as TileView {
  +Hiển thị vùng chọn, di chuyển, tấn công, hợp thể()
}

class "Quân cờ 3D (6 mẫu Trung cổ)" as PieceView {
  +Máy trạng thái hoạt họa 5 pha
  +Biểu tượng phe & loại quân nổi 3D()
}

class "Đầu mối trung chuyển hoạt họa" as Relay {
  +Đồng bộ mốc khung hình tới VFX và âm thanh()
}

class "Quản lý giao diện tập trung" as UIMgr {
  +Điều phối màn hình chính & xếp chồng hộp thoại()
}

class "Bảng ánh xạ giao diện" as UIMapper {
  +Tra cứu tập trung tài nguyên màn hình()
}

class "Các màn hình chính" as Screens {
  +Màn hình chính & xây dựng đội hình (12 điểm)
  +Sảnh chờ trực tuyến (UIPopupLobby)
  +Bảng thông số trong trận & Cài đặt
}

VisualQ ..|> OutPort
VisualQ --> SeqBuilder
VisualQ --> BoardView
SeqBuilder --> Nodes
BoardView "1" *-- "36" TileView
BoardView "1" *-- "0..36" PieceView
PieceView *-- Relay
UIMgr --> UIMapper
UIMgr --> Screens
Screens ..> VisualQ : nhận cập nhật thông số
@enduml
