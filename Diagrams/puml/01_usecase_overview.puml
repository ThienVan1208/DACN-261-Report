@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam BorderColor #475569
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155
skinparam UsecaseBackgroundColor #F1F5F9
skinparam UsecaseBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorBorderColor #334155
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155
skinparam SequenceParticipantBackgroundColor #F1F5F9
skinparam SequenceParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706

left to right direction

actor "Người chơi chính\n(Player 1)" as P1
actor "Người chơi 2 /\nĐối thủ Online" as P2
actor "Khán giả\n(Spectator)" as Spec
actor "Bot AI\n(Minimax/RL/NNUE/LLM)" as Bot

rectangle "Hệ thống game Convergence Chess (Giai đoạn 1 - DACN)" {
  package "Chuẩn bị và cấu hình" {
    usecase "UC01: Xây dựng và lưu đội hình\n(Squad Builder - 12 Slot Points)" as UC1
    usecase "UC02: Cài đặt tên người chơi & hệ thống\n(UIPopupSettings / SaveLoad)" as UC2
    usecase "UC03: Tùy biến nhân vật 3D từ ảnh\n(Smart Customization - CLI)" as UC3
  }
  package "Quản lý phòng Online" {
    usecase "UC04: Chọn khu vực máy chủ\n(Photon Region)" as UC4
    usecase "UC05: Tạo / Tham gia phòng chơi\n(Photon GameMode.Shared)" as UC5
    usecase "UC06: Chọn vai trò (Trắng/Đen/Khán giả)\nvà đồng bộ Sẵn sàng" as UC6
  }
  package "Thi đấu chiến thuật 6x6" {
    usecase "UC07: Đấu PvE với Bot AI" as UC7
    usecase "UC08: Đấu PvP Offline (Hotseat)" as UC8
    usecase "UC09: Đấu PvP Online (Photon Fusion)" as UC9
    usecase "UC10: Di chuyển, Tấn công, Hợp thể\n(Merge) và Surge Phase" as UC10
    usecase "UC11: Bỏ lượt (Pass Turn)\n& Khung đầu hàng (GĐ2)" as UC11
    usecase "UC12: Quan sát trận đấu trực tiếp" as UC12
  }
}

P1 --> UC1
P1 --> UC2
P1 --> UC3
P1 --> UC4
P1 --> UC5
P1 --> UC6
P1 --> UC7
P1 --> UC8
P1 --> UC9

P2 --> UC5
P2 --> UC6
P2 --> UC8
P2 --> UC9

Spec --> UC5
Spec --> UC6
Spec --> UC12

Bot --> UC7

UC7 .> UC10 : <<include>>
UC8 .> UC10 : <<include>>
UC9 .> UC10 : <<include>>
UC10 .> UC11 : <<extend>>
@enduml
