@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155

top to bottom direction

package "Khởi tạo và cô lập theo từng bàn đấu" #F1F5F9 {
  [Bộ lắp ráp chế độ chơi\n(Đấu máy, Đấu 2 người, Trực tuyến, Huấn luyện AI)] as Boot
  [Vùng quản lý dịch vụ độc lập\ncho từng bàn đấu] as Locator
  Boot --> Locator : lắp ráp dịch vụ
}

package "Nguồn phát sinh nước đi (Driving Adapters)" #EFF6FF {
  [Điều khiển chuột\n(Người chơi cục bộ)] as Raycast
  [Tầng mạng trực tuyến\n(Photon Fusion Shared)] as NetCtrl
  [Hybrid Bot\n(Minimax + PPO + NNUE)] as HybridBot
  [LLM Bot\n(Ngân hàng luật biểu tượng)] as LLMBot
}

rectangle "Cổng tiếp nhận nước đi thống nhất" as InPort #DBEAFE

package "Khối lõi luật chơi (Tách rời hoàn toàn đồ họa 3D)" #ECFDF5 {
  [Bộ điều phối vòng lặp trận đấu] as MatchMgr
  [Bộ xử lý sự kiện và cập nhật bàn cờ] as EvtHandler
  [Trạng thái bàn cờ 6x6\n(Vật cản, Điểm AP, Đòn bồi Surge)] as State
  [Bộ thẩm định luật chơi\n(Di chuyển, Hợp thể, Chiếu Vua)] as Validator
  [Quân cờ & 9 kỹ năng nội tại] as Piece
  [Cấu hình cân bằng tập trung\n(ScriptableObject, 12 điểm)] as Config
  MatchMgr --> EvtHandler
  MatchMgr --> State
  EvtHandler --> State
  EvtHandler --> Validator
  State *-- Piece
  State --> Config
}

rectangle "Cổng phát sự kiện diễn biến ván đấu" as OutPort #FEF3C7

package "Thành phần tiếp nhận sự kiện (Driven Adapters)" #FFFBEB {
  [Hàng đợi diễn hoạt 3D\n(Bàn cờ, Quân cờ, Giao diện)] as VisualQ
  [Xoay bàn cờ & Đếm giờ lượt] as AuxList
  [Định hình phần thưởng AI\n(Hàm thế năng NNUE)] as RewardList
  [Chế độ chạy không đồ họa\n(Huấn luyện AI song song)] as NullList
  [Ghi nhận đối kháng tự động] as BenchRec
}

package "Phân hệ mở rộng: Tùy biến nhân vật 3D (Sẵn sàng thương mại hóa)" #F5F3FF {
  [Giao diện tùy biến Unity 6\n(Chọn ảnh 2D, 6 kiểu tóc 3D)] as SCUnity
  [Bộ xử lý cục bộ tự xây dựng\n(Hình học 25 thông số + Chiếu ngược PyTorch3D\n+ Khử bóng đối xứng Lab, tắt HRN & IC-Light)] as SCPy
  SCUnity <--> SCPy : trao đổi thông số & bản đồ da
}

Raycast ..|> InPort
NetCtrl ..|> InPort
HybridBot ..|> InPort
LLMBot ..|> InPort

InPort --> MatchMgr : lệnh nước đi
Locator ..> MatchMgr : cấp phát cổng giao tiếp
MatchMgr --> OutPort : đợt sự kiện tuần tự

VisualQ ..|> OutPort
AuxList ..|> OutPort
RewardList ..|> OutPort
NullList ..|> OutPort
BenchRec ..|> OutPort
@enduml
