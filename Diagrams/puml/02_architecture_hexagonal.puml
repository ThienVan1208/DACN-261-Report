@startuml
!pragma layout smetana
skinparam dpi 170
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam BorderColor #475569
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassBorderColor #334155
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #64748B
skinparam ComponentBackgroundColor #F8FAFC
skinparam ComponentBorderColor #334155
skinparam RectangleBackgroundColor #F8FAFC
skinparam RectangleBorderColor #334155
skinparam UsecaseBackgroundColor #F1F5F9
skinparam UsecaseBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorBorderColor #334155
skinparam StateBackgroundColor #F8FAFC
skinparam StateBorderColor #334155
skinparam SequenceParticipantBackgroundColor #F1F5F9
skinparam SequenceParticipantBorderColor #334155
skinparam SequenceLifeLineBorderColor #64748B
skinparam SequenceGroupBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706

top to bottom direction

package "Composition Root (Khởi tạo chế độ chơi)" #F1F5F9 {
  [IModeBootstrapper] as Boot
  [PveModeBootstrapper] as PvEBoot
  [PvPOffModeBootstrapper] as OffBoot
  [PvPOnlModeBootstrapper] as OnlBoot
  [Training / Benchmark Bootstrappers] as TrainBoot
  [ArenaServiceLocator\n(Scoped DI Container)] as Locator
  PvEBoot -u-|> Boot
  OffBoot -u-|> Boot
  OnlBoot -u-|> Boot
  TrainBoot -u-|> Boot
  Boot --> Locator : đăng ký dịch vụ
}

package "Driving Adapters (Nguồn phát sinh nước đi)" #EFF6FF {
  [RaycastController\n(Human Local Input)] as Raycast
  [OnlineLocalMoveSender +\nNetworkController\n(Photon Shared / ReliableData)] as NetCtrl
  [AgentBotController\n(ML-Agents PPO/BC &\nHeuristic Minimax)] as RLBot
  [NeuralMinimaxBotController\n(Policy + MinimaxEval)] as NMxBot
  [HybridAgentBotController /\nNNUEBotController\n(NNUE / Residual)] as NNUEBot
  [LLMBotController\n(Symbolic Bank)] as LLMBot
}

rectangle "Driving Port\n<<interface>> IMoveInputProvider" as InPort #DBEAFE

package "Core Domain & Application Loop (Tách rời đồ họa 3D)" #ECFDF5 {
  [MatchManager\n(MonoBehaviour UniTask Loop)] as MatchMgr
  [GameEventHandler\n(ExecuteCommand -> EventBatch)] as EvtHandler
  [GameState\n(Bàn 6x6, MaxAP=5, Obstacles, Surge)] as State
  [MoveValidator\n(ValidateAction, GenerateLegalMovesFast)] as Validator
  [Piece & PassiveFlags\n(9-bit ushort bitmask)] as Piece
  [SquadValidator & GameConfig\n(ScriptableObject, 12 Slots)] as Config
  MatchMgr --> EvtHandler
  MatchMgr --> State
  EvtHandler --> State
  EvtHandler --> Validator
  State *-- Piece
  State --> Config
}

rectangle "Driven Port\n<<interface>> IGameEventListener" as OutPort #FEF3C7

package "Driven Adapters (Hiển thị, huấn luyện và kiểm chuẩn)" #FFFBEB {
  [VisualQueueManager\n+ BoardView / PieceView / UI] as VisualQ
  [BoardRotator & OnlineTurnTimer\n(PvP Offline / Đếm giờ 60s)] as AuxList
  [AgentRewardHandler\n(NNUE Potential Reward Shaping)] as RewardList
  [NullGameEventListener\n(Headless Training)] as NullList
  [BenchmarkGameEventManager\n-> BenchmarkRunner -> FileBenchmarkRecorder] as BenchRec
}

package "External Module (Smart Customization - Local Python CLI)" #F5F3FF {
  [SCCharacterCreator\n(Unity UGUI + URP PBR)] as SCUnity
  [Python CLI (infer_onnx.py)\n(MediaPipe + ONNX B1 v2 + PyTorch3D\n+ Bilateral Delighting + HRN)] as SCPy
  SCUnity <--> SCPy : ProcessStartInfo / sc_result.json + PNG
}

Raycast ..|> InPort
NetCtrl ..|> InPort
RLBot ..|> InPort
NMxBot ..|> InPort
NNUEBot ..|> InPort
LLMBot ..|> InPort

InPort --> MatchMgr : UniTask<MoveCommand>
Locator ..> MatchMgr : inject Ports
MatchMgr --> OutPort : GameEventBatch

VisualQ ..|> OutPort
AuxList ..|> OutPort
RewardList ..|> OutPort
NullList ..|> OutPort
BenchRec ..|> OutPort
@enduml
